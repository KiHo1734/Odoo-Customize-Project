<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_shopfloor_mo_kanban" model="ir.ui.view">
        <field name="name">shopfloor.mo.kanban</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="product_id"/>
                <field name="state"/>
                <field name="product_qty"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card p-3">
                            <strong>
                                <t t-esc="record.name.value"/>
                            </strong>

                            <div>
                                Product: <t t-esc="record.product_id.value"/>
                            </div>

                            <div>
                                Qty: <t t-esc="record.product_qty.value"/>
                            </div>

                            <div>
                                Status: <t t-esc="record.state.value"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>