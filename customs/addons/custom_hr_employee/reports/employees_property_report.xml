<odoo>
  <data>
    <!-- สร้าง ir.model สำหรับโมเดล wizard -->
    <record id="model_hr_retirement_report_wizard" model="ir.model">
      <field name="name">hr.retirement.report.wizard</field>
      <field name="model">hr.retirement.report.wizard</field>
    </record>

    <!-- รายงาน -->
    <record id="action_report_retirement_employee_list" model="ir.actions.report">
      <field name="name">Employee List</field>
      <field name="model">hr.retirement.report.wizard</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">custom_hr_employee.report_employee_list_template</field>
      <field name="report_file">custom_hr_employee.report_employee_list_template</field>
      <field name="print_report_name">'Retirement_Employees_List'</field>
      <field name="binding_model_id" ref="custom_hr_employee.model_hr_retirement_report_wizard"/>
      <field name="binding_type">report</field>
    </record>
  </data>
</odoo>


