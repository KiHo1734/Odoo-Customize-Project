<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="report_employee_list_template">
    <style>
      .page { padding-top: 0 !important; }
    </style>

    <t t-set="form" t-value="form"/>
    <t t-set="employee_ids" t-value="employee_ids"/>
    <t t-set="departments" t-value="employee_ids.mapped('department_id').filtered(lambda d: d).sorted(key=lambda d: d.name)"/>

    <t t-call="web.external_layout">
      <main class="page">
        <h2 class="text-center">รายงานพนักงานเกษียณ</h2>

      <p>
        รายงานนี้แสดงรายชื่อพนักงานที่มีกำหนดเกษียณในช่วงวันที่
        <t t-esc="form.get('date_from', '')"/>
          ถึง
        <t t-esc="form.get('date_to', '')"/>
        (พิมพ์เมื่อ: <t t-esc="datetime.datetime.today().strftime('%d/%m/%Y')"/>)
      </p>


        <t t-foreach="departments" t-as="department">
          <h3 class="mt16"><t t-esc="department.name"/></h3>

          <table class="table table-sm table-hover o_main_table">
            <thead>
              <tr>
                <th>No.</th>
                <th>Employee</th>
                <th>Job Position</th>
                <th>Start Date</th>
                <th>Retirement Date</th>
                <th>Days Until Retirement</th>
                <th>Current Salary</th>
                <th>Annual Salary</th>
              </tr>
            </thead>
            <tbody>
              <t t-set="dept_employees" t-value="employee_ids.filtered(lambda e: e.department_id.id == department.id).sorted(key=lambda e: e.name)"/>
              <t t-set="emp_counter" t-value="0"/>
              <t t-foreach="dept_employees" t-as="employee">
                <t t-set="emp_counter" t-value="emp_counter + 1"/>
                <tr>
                  <td><t t-esc="emp_counter"/></td>
                  <td><t t-esc="employee.name"/></td>
                  <td><t t-esc="employee.job_id.name or '-'"/></td>
                  <td><t t-esc="employee.start_date.strftime('%d/%m/%Y') if employee.start_date else '-'"/></td>
                  <td><t t-esc="employee.retirement_date.strftime('%d/%m/%Y') if employee.retirement_date else '-'"/></td>
                  <td><t t-esc="employee.days_left_to_retire or '-'"/></td>
                  <td><t t-esc="'{:,.2f}'.format(employee.salary or 0.0)"/></td>
                  <td><t t-esc="'{:,.2f}'.format((employee.salary or 0.0) * 12)"/></td>
                </tr>
              </t>
            </tbody>
          </table>
        </t>
      </main>
    </t>
  </template>
</odoo>
