<!-- views/employee_skill_graph_view.xml -->
<odoo>
    <!-- กราฟแท่งแบบ Stacked -->
    <record id="view_employee_skill_graph" model="ir.ui.view">
        <field name="name">hr.employee.skill.graph</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <graph string="Employee Skills by Department" type="bar" stacked="True">
                <field name="id" type="measure"/>
                <field name="leaf_department_name" groupby="True"/>
                <field name="skill_type_id" groupby="True"/>
            </graph>    
        </field>
    </record>

    <!-- กราฟวงกลม แสดงสัดส่วนของแต่ละแผนก -->
    <record id="view_employee_skill_graph_pie" model="ir.ui.view">
        <field name="name">hr.employee.skill.graph.pie</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <graph string="Skills Distribution by Department" type="pie">
                <field name="id" type="measure"/>
                <field name="leaf_department_name" groupby="True"/>
            </graph>    
        </field>
    </record>

    <!-- กราฟเส้น แสดงแนวโน้มตามระดับทักษะ -->
    <record id="view_employee_skill_graph_line" model="ir.ui.view">
        <field name="name">hr.employee.skill.graph.line</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <graph string="Skills by Level Trend" type="line">
                <field name="id" type="measure"/>
                <field name="skill_level_id" groupby="True"/>
                <field name="leaf_department_name" groupby="True"/>
            </graph>    
        </field>
    </record>

    <!-- ตาราง List View พร้อม Filter และ Search -->
    <record id="view_employee_skill_list" model="ir.ui.view">
        <field name="name">hr.employee.skill.list</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <list string="Employee Skills" 
                  decoration-success="skill_progress_percentage &gt;= 80"
                  decoration-warning="skill_progress_percentage &gt;= 50 and skill_progress_percentage &lt; 80"
                  decoration-danger="skill_progress_percentage &gt; 0 and skill_progress_percentage &lt; 50">
                <field name="employee_id"/>
                <field name="leaf_department_name"/>
                <field name="skill_type_id"/>
                <field name="skill_id"/>
                <field name="skill_level_id"/>
                <field name="skill_progress_percentage" widget="progressbar"/>
            </list>
        </field>
    </record>

    <!-- Search View พร้อม Filter และ Group By -->
    <record id="view_employee_skill_search" model="ir.ui.view">
        <field name="name">hr.employee.skill.search</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <search string="Employee Skills Search">
                <!-- Search Fields -->
                <field name="employee_id"/>
                <field name="skill_id"/>
                <field name="skill_type_id"/>
                <field name="leaf_department_name"/>
                
                <!-- Filters -->
                <filter string="Active Employees" 
                        name="active_employees" 
                        domain="[('employee_id.active','=', True)]"/>
                        
                <filter string="High Level Skills" 
                        name="high_level" 
                        domain="[('skill_progress_percentage','&gt;=', 80)]"/>
                        
                <filter string="Medium Level Skills" 
                        name="medium_level" 
                        domain="[('skill_progress_percentage','&gt;=', 50), ('skill_progress_percentage','&lt;', 80)]"/>
                        
                <filter string="Low Level Skills" 
                        name="low_level" 
                        domain="[('skill_progress_percentage','&gt;', 0), ('skill_progress_percentage','&lt;', 50)]"/>
                
                <separator/>
                
                <!-- Group By -->
                <group expand="1" string="Group By">
                    <filter string="Department" 
                            name="group_department" 
                            context="{'group_by': 'employee_department_id'}"/>
                    <filter string="Skill Type" 
                            name="group_skill_type" 
                            context="{'group_by': 'skill_type_id'}"/>
                    <filter string="Skill Level" 
                            name="group_skill_level" 
                            context="{'group_by': 'skill_level_id'}"/>
                    <filter string="Employee" 
                            name="group_employee" 
                            context="{'group_by': 'employee_id'}"/>
                </group>

            </search>
        </field>
    </record>

    <!-- Kanban View สำหรับมุมมองการ์ด -->
    <record id="view_employee_skill_kanban" model="ir.ui.view">
        <field name="name">hr.employee.skill.kanban</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <kanban default_group_by="leaf_department_name">
                <field name="employee_id"/>
                <field name="skill_id"/>
                <field name="skill_type_id"/>
                <field name="skill_level_id"/>
                <field name="skill_progress_percentage"/>
                <field name="leaf_department_name"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="oe_kanban_details">
                                    <strong><field name="employee_id"/></strong>
                                    <div>
                                        <span class="badge badge-info">
                                            <field name="skill_id"/>
                                        </span>
                                    </div>
                                    <div>
                                        <field name="skill_type_id"/>
                                    </div>
                                    <div>
                                        Level: <field name="skill_level_id"/>
                                    </div>
                                    <div class="mt-2">
                                        <field name="skill_progress_percentage" widget="progressbar"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action หลักสำหรับเปิด Skills Graph -->
    <record id="action_employee_skill_graph" model="ir.actions.act_window">
        <field name="name">Employee Skills Analysis</field>
        <field name="res_model">hr.employee.skill</field>
        <field name="view_mode">graph,list,kanban</field>
        <field name="views"
            eval="[(ref('view_employee_skill_graph'), 'graph'),
                   (ref('view_employee_skill_list'), 'list'),
                   (ref('view_employee_skill_kanban'), 'kanban')]"/>
        <field name="search_view_id" ref="view_employee_skill_search"/>
        <field name="domain">[('employee_id.active','=', True)]</field>
        <field name="context">
            {
                'group_by': ['leaf_department_name', 'skill_type_id'],
                'search_default_active_employees': 1
            }
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No employee skills found!
            </p>
            <p>
                Skills data will appear here once employees have been assigned skills.
            </p>
        </field>
    </record>

    <!-- Action แยกสำหรับ list view โดยเฉพาะ ตั้ง group_by -->
    <record id="action_employee_skill_list_grouped" model="ir.actions.act_window">
        <field name="name">Employee Skills List Grouped</field>
        <field name="res_model">hr.employee.skill</field>
        <field name="view_mode">list</field>
        <field name="views" eval="[(ref('view_employee_skill_list'), 'list')]"/>
        <field name="search_view_id" ref="view_employee_skill_search"/>
        <field name="domain">[('employee_id.active','=', True)]</field>
        <field name="context">
            {
                'group_by': ['leaf_department_name', 'skill_type_id', 'employee_id'],
                'search_default_active_employees': 1
            }
        </field>
    </record>

    <!-- Action สำหรับกราฟแบบต่างๆ -->
    <record id="action_employee_skill_pie_chart" model="ir.actions.act_window">
        <field name="name">Skills Distribution</field>
        <field name="res_model">hr.employee.skill</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_employee_skill_graph_pie"/>
        <field name="domain">[('employee_id.active','=', True)]</field>
    </record>

    <record id="action_employee_skill_trend" model="ir.actions.act_window">
        <field name="name">Skills Level Trend</field>
        <field name="res_model">hr.employee.skill</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_employee_skill_graph_line"/>
        <field name="domain">[('employee_id.active','=', True)]</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_employee_skill_analysis"
        name="Skills Analysis"
        parent="hr.menu_hr_root"
        sequence="60"/>

    <menuitem id="menu_employee_skill_graph"
        name="Skills Overview"
        parent="menu_employee_skill_analysis"
        action="action_employee_skill_graph"
        sequence="10"/>

    <menuitem id="menu_employee_skill_distribution"
        name="Skills Distribution"
        parent="menu_employee_skill_analysis"
        action="action_employee_skill_pie_chart"
        sequence="20"/>

    <menuitem id="menu_employee_skill_trend"
        name="Skills Trend"
        parent="menu_employee_skill_analysis"
        action="action_employee_skill_trend"
        sequence="30"/>

    <menuitem id="menu_employee_skill_list_grouped"
            name="Skills List"
            parent="menu_employee_skill_analysis"
            action="action_employee_skill_list_grouped"
            sequence="15"/>
</odoo>