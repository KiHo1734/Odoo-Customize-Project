<odoo>
  <record id="view_employee_form_private_info" model="ir.ui.view">
    <field name="name">hr.employee.form.private.info</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='country_id']" position="before">
        <field name="id_card_image" filename="id_card_image_filename"/>
        <button name="extract_info_from_image" type="object" string="Recognize" class="btn btn-primary"/>
      </xpath>
      <xpath expr="//field[@name='country_of_birth']" position="after">
        <field name="religion"/>
      </xpath>
      <xpath expr="//field[@name='private_car_plate']" position="before">
        <field name="travel_method"/>
      </xpath>
      <xpath expr="//field[@name='private_car_plate']" position="replace">
        <field name="private_car_plate" invisible="not show_private_car_plate"/>
      </xpath>
    </field>
  </record>
</odoo>