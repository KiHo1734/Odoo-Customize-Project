<odoo>
    <record id="view_hr_attendance_settings_inherit_work_hours" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.hr.attendance.work.hours</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- เพิ่มหลัง block "Modes" -->
            <xpath expr="//block[@name='kiosk_mode_setting_container']" position="after">
                <block title="Work Hours">
                    <setting string="Work Start" company_dependent="1">
                        <field name="work_start"/>
                    </setting>
                    <setting string="Work End" company_dependent="1">
                        <field name="work_end"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
