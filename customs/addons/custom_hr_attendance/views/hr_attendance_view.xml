<odoo>
    <record id="view_attendance_list_inherit_export" model="ir.ui.view">
        <field name="name">hr.attendance.list.inherit.export</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_export_csv"
                        type="object"
                        string="Export CSV"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>