<odoo>
  <record id="view_employee_form_inherit_face" model="ir.ui.view">
    <field name="name">hr.employee.form.face</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">
        <xpath expr="//sheet/notebook/page[@name='personal_information']" position="inside">
            <group>
                <field name="face_encoding" readonly="1"/>
                <button name="action_regenerate_face_encodings"
                        string="Regenerate Face Encoding"
                        type="object"
                        class="btn-primary"/>
                <button name="action_check_face"
                    string="Regenerate Face Encoding Test"
                    type="object"
                    class="btn-primary"/>
            </group>
        </xpath>
    </field>
  </record>
</odoo>
